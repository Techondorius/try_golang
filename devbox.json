{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "go@latest",
    "gopls@latest"
  ],
  "env": {
    "GOCACHE": "$PWD/.cache/go-build"
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "start": "go run .",
      "test": "go test ./...",
      "check": [
        "go test -race ./...",
        "go vet ./...",
        "go build ./..."
      ]
    }
  }
}
